import /init.recovery.kirin710.usb.rc

on fs
    start fixlinks

service fixlinks /system/bin/fixlinks.sh
    oneshot
    disabled
    seclabel u:r:recovery:s0

on init
    write /proc/sys/kernel/hung_task_timeout_secs 0

    start watchdogd
    setprop logd.ready true

on late-init
    setprop sys.usb.controller ff100000.dwc3
    setprop ro.debuggable 1
    setprop service.adb.root 1
    setprop sys.usb.configfs 1
    setprop sys.usb.config adb

service oeminfo_nvm /sbin/true
    disabled

#tp hostprocessing daemon
service aptouch /vendor/bin/aptouch_daemon
    user root
    group root system shell dsm wakelock
    disabled
    seclabel u:r:aptouch:s0

# on boot
#     start aptouch

on property:odm.thp.service_enable=1
    start aptouch

on property:odm.thp.service_enable=0
    stop aptouch