# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount point  fstype device                             device2              	flags
/boot				emmc		/dev/block/platform/hi_mci.0/by-name/kernel  	              flags=display="Boot";backup=1;flashimg=1
/recovery_ramdisk   emmc        /dev/block/platform/hi_mci.0/by-name/recovery_ramdisk   flags=display="Recovery_Ramdisk";backup=1;flashimg=1
/recovery_vendor    emmc        /dev/block/platform/hi_mci.0/by-name/recovery_vendor   flags=display="Recovery_Vendor";backup=1;flashimg=1
/erecovery_ramdisk   emmc        /dev/block/platform/hi_mci.0/by-name/erecovery_ramdisk   flags=display="eRecovery_Ramdisk";backup=1;flashimg=1
/erecovery_vendor    emmc        /dev/block/platform/hi_mci.0/by-name/erecovery_vendor   flags=display="eRecovery_Vendor";backup=1;flashimg=1
/data                           f2fs            /dev/block/platform/hi_mci.0/by-name/userdata             flags=display="Data";backup=1
/dts				emmc		/dev/block/platform/hi_mci.0/by-name/dts	              flags=display="DTS";backup=1;flashimg=1
/dto				emmc		/dev/block/platform/hi_mci.0/by-name/dto	              flags=display="DTO";backup=1;flashimg=1
/persist		        emmc		/dev/block/platform/hi_mci.0/by-name/persist              flags=display="Persist";backup=1;flashimg=1
/vbmeta				emmc		/dev/block/platform/hi_mci.0/by-name/vbmeta	              flags=display="VBMeta";backup=1;flashimg=1
/cache              ext4        /dev/block/platform/hi_mci.0/by-name/cache                flags=display="Cache";backup=1

# Crucial read-only partitions
/erecovery_kernel   emmc        /dev/block/platform/hi_mci.0/by-name/erecovery_kernel     flags=display="eRecovery_Kernel";backup=1;flashimg=1
/oeminfo            emmc        /dev/block/platform/hi_mci.0/by-name/oeminfo              flags=display="OEMInfo";backup=1;flashimg=1
/nvme               emmc        /dev/block/platform/hi_mci.0/by-name/nvme                 flags=display="NVMe";backup=1
/modemnvm_update    emmc        /dev/block/platform/hi_mci.0/by-name/modemnvm_update      flags=display="ModemNVM_Update";backup=1
/modemnvm_cust      emmc        /dev/block/platform/hi_mci.0/by-name/modemnvm_cust        flags=display="ModemNVM_Cust";backup=1
/modem_fw			emmc		/dev/block/platform/hi_mci.0/by-name/modem_fw	          flags=backup=1;display="Modem_FW"
/modem_secure		emmc		/dev/block/platform/hi_mci.0/by-name/modem_secure         flags=backup=1;display="Modem_Secure"

# System partitions (leave them as ext4 for now)
/system_root  ext4        /dev/block/bootdevice/by-name/system                                      flags=logical;display="System";backup=1;flashimg=0
/system_ext   ext4        /dev/block/mapper/system_ext                                  flags=logical;display="System_Ext";backup=1;flashimg=0
/vendor       ext4        /dev/block/mapper/vendor                                      flags=logical;display="Vendor";backup=1;flashimg=0
/odm          ext4        /dev/block/mapper/odm                                         flags=logical;display="ODM";backup=1;flashimg=0
/product      ext4        /dev/block/mapper/product                                     flags=logical;display="Product";backup=1;flashimg=0
/cust         ext4        /dev/block/mapper/cust                                        flags=logical;display="Cust";backup=1;flashimg=0
/hw_product   ext4        /dev/block/mapper/hw_product                                  flags=logical;display="HW_Product";backup=1;flashimg=0

# Logical Points
system              /system_root ext4        ro,barrier=1,discard                wait,logical,first_stage_mount
system              /system_root erofs       ro                                  wait,logical,first_stage_mount
system_ext          /system_ext  ext4        ro,barrier=1,discard                wait,logical,first_stage_mount
system_ext          /system_ext  erofs       ro                                  wait,logical,first_stage_mount
vendor              /vendor      ext4        ro,barrier=1,discard                wait,logical,first_stage_mount
vendor              /vendor      erofs       ro                                  wait,logical,first_stage_mount
product             /product     ext4        ro,barrier=1,discard                wait,logical,first_stage_mount
product             /product     erofs       ro                                  wait,logical,first_stage_mount
odm                 /odm         ext4        ro,barrier=1,discard                wait,logical,first_stage_mount
odm                 /odm         erofs       ro                                  wait,logical,first_stage_mount
cust                /cust        ext4        ro,barrier=1,discard                wait,logical,first_stage_mount
cust                /cust        erofs       ro                                  wait,logical,first_stage_mount
hw_product          /hw_product  ext4        ro,barrier=1,discard                wait,logical,first_stage_mount
hw_product          /hw_product  erofs       ro                                  wait,logical,first_stage_mount


# Logical (super) partitions
/system_image       emmc        /dev/block/bootdevice/by-name/system                                      flags=logical;display="System Image";backup=1;flashimg=1
/system_ext_image   emmc        /dev/block/bootdevice/by-name/system_ext                                  flags=logical;display="System_Ext Image";backup=1;flashimg=1
/vendor_image       emmc        /dev/block/bootdevice/by-name/vendor                                      flags=logical;display="Vendor Image";backup=1;flashimg=1
/odm_image          emmc        /dev/block/bootdevice/by-name/odm                                         flags=logical;display="ODM Image";backup=1;flashimg=1
/product_image      emmc        /dev/block/bootdevice/by-name/product                                     flags=logical;display="Product Image";backup=1;flashimg=1
/cust_image         emmc        /dev/block/bootdevice/by-name/cust                                        flags=logical;display="Cust Image";backup=1;flashimg=1
/hw_product_image   emmc        /dev/block/bootdevice/by-name/hw_product                                  flags=logical;display="HW_Product Image";backup=1;flashimg=1

# Removable storage
/usb_otg			auto 		/dev/block/sde1                    /dev/block/sde             flags=fsflags=utf8;display="USB OTG";storage;wipeingui;removable
/external_sd		auto 		/dev/block/mmcblk1p1               /dev/block/mmcblk1         flags=fsflags=utf8;display="Micro SD Card";storage;wipeingui;removable
