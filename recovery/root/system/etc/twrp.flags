# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount point  fstype device                             device2              	flags
/kernel				emmc		/dev/block/platform/hi_mci.0/by-name/kernel  	              flags=display="Kernel";backup=1;flashimg=1
/ramdisk			emmc		/dev/block/platform/hi_mci.0/by-name/ramdisk            flags=display="Ramdisk";backup=1;flashimg=1
/recovery_ramdisk   emmc        /dev/block/platform/hi_mci.0/by-name/recovery_ramdisk   flags=display="Recovery_Ramdisk";backup=1;flashimg=1
/recovery_vendor    emmc        /dev/block/platform/hi_mci.0/by-name/recovery_vendor   flags=display="Recovery_Vendor";backup=1;flashimg=1
/erecovery_ramdisk   emmc        /dev/block/platform/hi_mci.0/by-name/erecovery_ramdisk   flags=display="eRecovery_Ramdisk";backup=1;flashimg=1
/erecovery_vendor    emmc        /dev/block/platform/hi_mci.0/by-name/erecovery_vendor   flags=display="eRecovery_Vendor";backup=1;flashimg=1
/data                           f2fs            /dev/block/platform/hi_mci.0/by-name/userdata             flags=display="Data";backup=1
/dts				emmc		/dev/block/platform/hi_mci.0/by-name/dts	              flags=display="DTS";backup=1;flashimg=1
/dto				emmc		/dev/block/platform/hi_mci.0/by-name/dto	              flags=display="DTO";backup=1;flashimg=1
/persist		        emmc		/dev/block/platform/hi_mci.0/by-name/persist              flags=display="Persist";backup=1;flashimg=1
/vbmeta				emmc		/dev/block/platform/hi_mci.0/by-name/vbmeta	              flags=display="VBMeta";backup=1;flashimg=1
/cache              ext4        /dev/block/platform/hi_mci.0/by-name/cache                flags=display="Cache";backup=1

# Crucial read-only partitions
/erecovery_kernel   emmc        /dev/block/platform/hi_mci.0/by-name/erecovery_kernel     flags=display="eRecovery_Kernel";backup=1;flashimg=1
/oeminfo            emmc        /dev/block/platform/hi_mci.0/by-name/oeminfo              flags=display="OEMInfo";backup=1;flashimg=1
/nvme               emmc        /dev/block/platform/hi_mci.0/by-name/nvme                 flags=display="NVMe";backup=1
/modemnvm_update    emmc        /dev/block/platform/hi_mci.0/by-name/modemnvm_update      flags=display="ModemNVM_Update";backup=1
/modemnvm_cust      emmc        /dev/block/platform/hi_mci.0/by-name/modemnvm_cust        flags=display="ModemNVM_Cust";backup=1
/modem_fw			emmc		/dev/block/platform/hi_mci.0/by-name/modem_fw	          flags=backup=1;display="Modem_FW"
/modem_secure		emmc		/dev/block/platform/hi_mci.0/by-name/modem_secure         flags=backup=1;display="Modem_Secure"

# Direct image flashing partitions
/super                          emmc            /dev/block/platform/hi_mci.0/by-name/super	 
/system_image             emmc        /dev/block/mapper/system                                      flags=display="System image";backup=1;flashimg=1
/vendor_image             emmc        /dev/block/mapper/vendor                                      flags=display="Vendor image";backup=1;flashimg=1
/odm_image                emmc        /dev/block/mapper/odm                                         flags=display="ODM image";backup=1;flashimg=1
/cust_image               emmc        /dev/block/mapper/cust                                        flags=display="Cust image";backup=1;flashimg=1
/product_image               emmc        /dev/block/mapper/product                                        flags=display="Product image";backup=1;flashimg=1

# System partitions (leave them as ext4 for now)
/system_root				ext4		/dev/block/mapper/system                  flags=display="System";backup=1;wipeingui
/vendor				ext4		/dev/block/mapper/vendor                  flags=display="Vendor";backup=1;wipeingui
/odm				ext4		/dev/block/mapper/odm                     flags=display="ODM";backup=1;wipeingui
/product			ext4        /dev/block/mapper/product                 flags=display="Product";backup=1;wipeingui

# Removable storage
/usb_otg			auto 		/dev/block/sde1                    /dev/block/sde             flags=fsflags=utf8;display="USB OTG";storage;wipeingui;removable
/external_sd		auto 		/dev/block/mmcblk1p1               /dev/block/mmcblk1         flags=fsflags=utf8;display="Micro SD Card";storage;wipeingui;removable
